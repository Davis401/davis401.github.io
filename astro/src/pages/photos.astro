---
import PageLayout from '../layouts/PageLayout.astro'


import { Image } from 'astro:assets';

const photos = await Astro.glob('/src/assets/photos/*.{jpg,jpeg,png,webp}');
---


<PageLayout title="Photos">

    <div class="grid">
      {photos.map((photo) => (
        <Image src={photo.default} alt="" width={400} loading="lazy" />
      ))}
    </div>


</PageLayout>




